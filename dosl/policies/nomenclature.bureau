policy nomenclature
version 2
regulation "dosl-1.0 -- what is, and what is not, a sandwich"

# the directorate of nomenclature does not decide whether your lunch is good.
# it decides whether your lunch is, in the legal sense, happening.

note "the directorate reminds applicants that precedent is not appetite."

let vessel = lower(bread)

require not (vessel matches "tortilla" or vessel matches "wrap")
    else deny "a wrap is a burrito with a press agent. jurisdiction declined." severity 6

require not vessel matches "bowl"
    else deny "you have submitted a bowl. the directorate handles bread." severity 9

when vessel matches "baguette" and layers == 2 then
    note "hinged-vessel construction. filed under dosl-1.0 annex c, reluctantly."
    penalize 5 "hinged vessels remain a jurisdictional grey area."
end

when layers > 2 then
    award 7 "multi-deck construction. unambiguously a sandwich. refreshing."
end

when cheese != "none" and toasted and filling_count == 0 then
    note "classified as a toastie. assessment continues under sandwich rules."
    award 4 "toastie precedent applies. see dosl-1.0(iv)."
end

when count(words(declared_purpose)) > 12 then
    penalize 8 "declared purpose exceeds twelve words. brevity is also a virtue."
end

require count(declared_purpose) > 0
    else warn "no declared purpose. the directorate has assumed 'hunger'." severity 1

when declared_purpose matches "breakfast" and hour > 14 then
    penalize 9 "breakfast declared after 14:00. the directorate has seen this before."
end

assess 92
